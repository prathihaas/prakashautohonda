---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const homePage = await getEntry('pages', 'home');
const products = await getCollection('products');
const branches = await getCollection('branches');
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

if (!homePage) throw new Error("Could not find 'home' entry in 'pages' collection.");

const { title_te, description_en, description_te, seo_title, seo_description, hero_image } = homePage.data;

const WA = "https://wa.me/918886604615";
const PHONE = "tel:+918886604615";

// Marquee strip — model names already carried in the products collection.
const marquee = products.map((p) => p.data.name_en);

const servicePoints = [
  { en: 'Genuine Honda spare parts', te: 'ఒరిజినల్ స్పేర్ పార్ట్స్' },
  { en: 'Honda-trained technicians', te: 'హోండా శిక్షణ పొందిన మెకానిక్‌లు' },
  { en: 'Service at both branches', te: 'రెండు శాఖలలో సర్వీస్' },
  { en: 'Booking over WhatsApp', te: 'వాట్సాప్‌లో బుకింగ్' },
];

const popularModels = [
  { slug: 'activa-125', name: 'Honda Activa 125 Kamareddy' },
  { slug: 'activa-110', name: 'Honda Activa 110' },
  { slug: 'shine-125', name: 'Honda Shine 125' },
  { slug: 'sp-160', name: 'Honda SP 160' },
  { slug: 'unicorn', name: 'Honda Unicorn' },
  { slug: 'dio-125', name: 'Honda Dio 125' },
  { slug: 'sp-125', name: 'Honda SP 125' },
  { slug: 'hornet-2-0', name: 'Honda Hornet 2.0' },
];

const reviews = [
  { name: "Suresh K", stars: 5, text: "Excellent service at Prakash Auto Honda. Got my Activa 125 at the best price with easy EMI. Highly recommended!" },
  { name: "Ravi Shankar", stars: 5, text: "Very helpful staff. The process was smooth and they explained all the finance options clearly. Happy with my SP 125." },
  { name: "Priya Reddy", stars: 5, text: "Best Honda showroom in Kamareddy. Got a great deal on Dio 125 with zero down payment. Great experience." },
  { name: "Mahesh Yadav", stars: 4, text: "Good service and genuine parts. My Unicorn has been serviced here multiple times and always runs perfectly." },
];

const faqs = [
  { q: "Where is Prakash Auto Honda in Kamareddy?", a: "Prakash Auto Honda is located in Kamareddy, Telangana 503111. We also have a branch in Lingampet. Call 8886604615 for exact directions." },
  { q: "What is Honda Activa 125 price in Kamareddy?", a: "Honda Activa 125 on-road price in Kamareddy starts from ₹95,000. Call 8886604615 or WhatsApp for today's best offer." },
  { q: "Is EMI available on Honda bikes in Kamareddy?", a: "Yes! EMI from ₹2,100/month. Zero down payment on select models. Instant approval through multiple finance partners." },
  { q: "What are Prakash Auto Honda showroom timings?", a: "Monday to Saturday, 9 AM to 7 PM at both Kamareddy and Lingampet branches." },
  { q: "Which Honda bikes are available?", a: "Full range: Activa 125, Activa 110, Shine 125, Shine 100, SP 125, SP 160, Unicorn, Dio, Livo, Hornet 2.0, CB200X and more." },
  { q: "How to book a Honda test ride in Kamareddy?", a: "Call 8886604615 or WhatsApp us to book a free test ride at Prakash Auto Honda Kamareddy. Available Mon–Sat." },
];

// LocalBusiness schema with both branches
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "@id": "https://www.prakashautohonda.com/#organization",
  "name": "Prakash Auto Honda",
  "url": "https://www.prakashautohonda.com",
  "logo": "https://www.prakashautohonda.com/favicon.png",
  "telephone": "+91-8886604615",
  "foundingDate": "2022",
  "description": "Authorized Honda two-wheeler dealer in Kamareddy, Telangana with 2 branches.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hyderabad Road",
    "addressLocality": "Kamareddy",
    "addressRegion": "Telangana",
    "postalCode": "503111",
    "addressCountry": "IN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 18.3236, "longitude": 78.3428 },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  }],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.3",
    "reviewCount": "500",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Suresh K" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Excellent service at Prakash Auto Honda. Got my Activa 125 at the best price with easy EMI. Highly recommended!"
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Ravi Shankar" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Very helpful staff. The process was smooth and they explained all the finance options clearly. Happy with my SP 125."
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Priya Reddy" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Best Honda showroom in Kamareddy. Got a great deal on Dio 125 with zero down payment. Great experience."
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Mahesh Yadav" },
      "reviewRating": { "@type": "Rating", "ratingValue": "4", "bestRating": "5" },
      "reviewBody": "Good service and genuine parts. My Unicorn has been serviced here multiple times and always runs perfectly."
    }
  ],
  "brand": { "@type": "Brand", "name": "Honda" },
  "areaServed": ["Kamareddy", "Lingampet", "Banswada", "Nizamabad", "Telangana"],
  "sameAs": ["https://www.facebook.com/prakashautohonda"],
  "department": [
    {
      "@type": "AutoDealer",
      "name": "Prakash Auto Honda — Kamareddy",
      "telephone": "+91-8886680259",
      "address": { "@type": "PostalAddress", "streetAddress": "Kamareddy", "addressLocality": "Kamareddy", "addressRegion": "Telangana", "postalCode": "503111", "addressCountry": "IN" },
      "url": "https://www.prakashautohonda.com"
    },
    {
      "@type": "AutoDealer",
      "name": "Prakash Auto Honda — Lingampet",
      "telephone": "+91-9985033315",
      "address": { "@type": "PostalAddress", "streetAddress": "Main Road, Lingampetpet", "addressLocality": "Lingampet", "addressRegion": "Telangana", "addressCountry": "IN" },
      "url": "https://www.prakashautohonda.com"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is Prakash Auto Honda showroom in Kamareddy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Prakash Auto Honda main showroom is located in Kamareddy, Telangana 503111. We also have a branch in Lingampet. Call 8886604615 for directions." }
    },
    {
      "@type": "Question",
      "name": "What is the price of Honda Activa 125 in Kamareddy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Honda Activa 125 on-road price in Kamareddy starts from ₹95,000 onwards. Contact Prakash Auto Honda on 8886604615 for today's best offer and EMI options." }
    },
    {
      "@type": "Question",
      "name": "Does Prakash Auto Honda offer EMI for Honda bikes?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, Prakash Auto Honda offers easy EMI options starting from ₹2,100/month for Honda bikes and scooters through multiple finance partners." }
    },
    {
      "@type": "Question",
      "name": "What are Prakash Auto Honda showroom timings?",
      "acceptedAnswer": { "@type": "Answer", "text": "Prakash Auto Honda is open Monday to Saturday, 9 AM to 7 PM. Both Kamareddy and Lingampet branches follow the same timings." }
    },
    {
      "@type": "Question",
      "name": "Which Honda bikes are available at Prakash Auto Honda Kamareddy?",
      "acceptedAnswer": { "@type": "Answer", "text": "Prakash Auto Honda Kamareddy has the full Honda range — Activa 125, Activa 110, Shine 125, Shine 100, SP 125, SP 160, Unicorn, Dio 110, Dio 125, Livo, Hornet 2.0, CB Hornet 125, and CB200X." }
    },
    {
      "@type": "Question",
      "name": "How to book a Honda test ride in Kamareddy?",
      "acceptedAnswer": { "@type": "Answer", "text": "You can book a free test ride at Prakash Auto Honda Kamareddy by calling 8886604615 or WhatsApp at wa.me/918886604615. Test rides are available Monday to Saturday." }
    }
  ]
};
---

<Layout title={seo_title} description={seo_description} noOrgSchema={true}>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main>
    <!-- ==========================================================
         HERO — Marquee: oversized statement, the machine, the strip.
         ========================================================== -->
    <section class="relative overflow-hidden bg-paper">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 pt-10 pb-4 lg:pt-16">
        <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
          <div>
            <a href={PHONE} class="inline-flex items-center gap-2 rounded-full border border-rule bg-card px-3.5 py-1.5 text-xs font-medium text-ink2 transition-colors duration-150 ease-out hover:border-honda-red hover:text-honda-red">
              <span class="h-1.5 w-1.5 rounded-full bg-honda-red" aria-hidden="true"></span>
              Authorised Honda dealer · Kamareddy
            </a>

            <h1 class="mt-6 text-[clamp(2.25rem,5.4vw,4rem)] font-semibold leading-[1.06] tracking-tight text-ink">
              Every Honda in the range,<br class="hidden sm:block" />
              <span class="text-honda-red">priced today</span> in Kamareddy.
            </h1>

            <p class="mt-4 font-noto text-lg text-body">{title_te}</p>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-body">{description_en}</p>
            <p class="mt-2 max-w-xl font-noto text-sm text-muted">{description_te}</p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href={PHONE} class="hb">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2.1Z"/></svg>
                Call 88866 04615
              </a>
              <a
                href={`${WA}?text=${encodeURIComponent("Hi Prakash Auto Honda, I want to know today's best offer on Honda bikes in Kamareddy. [W-HP]")}`}
                target="_blank" rel="noopener noreferrer" class="hb hb--wa">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.5 14c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1a13 13 0 0 1-5.7-4.6c-.4-.6-1-1.5-1-2.9s.7-2 1-2.3a1 1 0 0 1 .7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.6l-.4.5c-.1.2-.3.3-.1.6a9.4 9.4 0 0 0 3.7 3c.3.2.5.1.6 0l.8-1c.2-.2.3-.2.6-.1l1.9.9c.3.1.5.2.5.4v.9Z"/></svg>
                Best price on WhatsApp
              </a>
            </div>

            <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-body">
              <li><a href="https://www.google.com/search?q=Prakash+Auto+Honda+Kamareddy+reviews" target="_blank" rel="noopener noreferrer" class="hover:text-honda-red transition-colors duration-150">4.3 / 5 · 500+ customers</a></li>
              <li aria-hidden="true" class="text-rule">·</li>
              <li><a href="#branches" class="hover:text-honda-red transition-colors duration-150">2 branches</a></li>
              <li aria-hidden="true" class="text-rule">·</li>
              <li><a href="/products/" class="hover:text-honda-red transition-colors duration-150">Full model range</a></li>
            </ul>
          </div>

          <div class="relative">
            <div class="absolute inset-x-6 bottom-6 top-16 rounded-lg bg-card" aria-hidden="true"></div>
            <img
              src={hero_image}
              alt="Honda Activa 125 at Prakash Auto Honda, the authorised Honda showroom in Kamareddy"
              class="relative w-full max-w-lg mx-auto object-contain"
              width="800" height="600"
              fetchpriority="high" loading="eager" decoding="async" />
          </div>
        </div>
      </div>

      <!-- Marquee strip -->
      <div class="border-y border-rule bg-card">
        <div class="ah-marquee py-3.5">
          <ul class="ah-marquee__track">
            {[...marquee, ...marquee].map((name, i) => (
              <li class="flex items-center gap-6 text-sm text-muted whitespace-nowrap" aria-hidden={i >= marquee.length ? 'true' : undefined}>
                <span>{name}</span>
                <span class="h-1 w-1 rounded-full bg-rule" aria-hidden="true"></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         EMI — the one red band on the page
         ========================================================== -->
    <section class="bg-honda-red text-white">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-lg font-semibold">Honda Activa EMI from ₹2,100 a month</p>
          <p class="text-sm text-white/80">Zero down payment on select models · instant approval</p>
        </div>
        <a
          href={`${WA}?text=${encodeURIComponent("Hi, I want to know about Honda EMI options in Kamareddy. [W-EMI]")}`}
          target="_blank" rel="noopener noreferrer"
          class="hb !bg-white !text-honda-red !border-white hover:!bg-honda-redTint self-start sm:self-auto">
          Check my EMI
        </a>
      </div>
    </section>

    <!-- ==========================================================
         MODELS
         ========================================================== -->
    <section class="py-14 lg:py-20 bg-paper">
      <div class="max-w-7xl mx-auto px-5 sm:px-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-[clamp(1.5rem,3vw,2.25rem)] font-semibold leading-tight text-ink">
              Honda bikes &amp; scooters in Kamareddy
            </h2>
            <p class="mt-1 font-noto text-body">కామారెడ్డిలో హోండా బైక్స్ మరియు స్కూటర్లు</p>
          </div>
          <a href="/products/" class="hb hb--outline self-start sm:self-auto">View all models</a>
        </div>

        <div class="mt-9 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {products.map((product) => (
            <ProductCard
              title_en={product.data.name_en}
              title_te={product.data.name_te}
              price={product.data.price}
              mileage={product.data.mileage || '—'}
              image={product.data.featured_image || ''}
              slug={product.slug}
              category={product.data.category}
            />
          ))}
        </div>

        <div class="mt-9 rounded-lg border border-ruleSoft bg-card p-6">
          <p class="text-sm text-body">
            Popular at <a href="/" class="text-honda-red underline underline-offset-2 decoration-honda-red/40 hover:decoration-honda-red">our Kamareddy showroom</a>:
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {popularModels.map((b) => (
              <li>
                <a href={`/products/${b.slug}`} class="inline-block rounded-full border border-ruleSoft px-3 py-1.5 text-xs text-ink2 transition-colors duration-150 ease-out hover:border-honda-red hover:text-honda-red">
                  {b.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         SERVICE
         ========================================================== -->
    <section class="border-y border-rule bg-card">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-14 lg:py-20">
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-honda-red">Service &amp; support</p>
            <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.25rem)] font-semibold leading-tight text-ink">
              Honda service, done by Honda-trained hands
            </h2>
            <h3 class="mt-2 font-noto text-lg font-medium text-body">కామారెడ్డిలో హోండా సర్వీసింగ్</h3>
            <p class="mt-4 max-w-lg text-base leading-relaxed text-body">
              Periodic service, running repairs and genuine parts at both the Kamareddy and
              Lingampet branches, Monday to Saturday.
            </p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              <a
                href={`${WA}?text=${encodeURIComponent("Hi, I want to book a service for my Honda in Kamareddy. [W-SVC]")}`}
                target="_blank" rel="noopener noreferrer" class="hb hb--wa">Book on WhatsApp</a>
              <a href="/service" class="hb hb--outline">Service details</a>
            </div>
          </div>

          <ul class="border-t border-rule">
            {servicePoints.map((s) => (
              <li class="flex items-start gap-4 border-b border-rule py-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-honda-red" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="min-w-0">
                  <span class="block text-base text-ink">{s.en}</span>
                  <span class="block font-noto text-sm text-muted">{s.te}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ==========================================================
         BRANCHES
         ========================================================== -->
    <section id="branches" class="py-14 lg:py-20 bg-paper">
      <div class="max-w-7xl mx-auto px-5 sm:px-8">
        <h2 class="text-[clamp(1.5rem,3vw,2.25rem)] font-semibold leading-tight text-ink">Showrooms near you</h2>
        <p class="mt-1 font-noto text-body">కామారెడ్డిలో మా షోరూమ్‌లు</p>
        <p class="mt-1 text-sm text-muted">Two branches — Kamareddy and Lingampet · Mon–Sat, 9 AM – 7 PM</p>

        <div class="mt-9 grid gap-5 md:grid-cols-2 max-w-4xl">
          {branches.map((branch) => (
            <div class="rounded-lg border border-ruleSoft bg-card p-6">
              <h3 class="text-lg font-semibold text-ink">{branch.data.name_en}</h3>
              <p class="mt-0.5 font-noto text-sm text-muted">{branch.data.name_te}</p>

              <p class="mt-4 text-sm leading-relaxed text-body">{branch.data.address_en}</p>
              <p class="mt-0.5 font-noto text-xs text-muted">{branch.data.address_te}</p>

              <a href={`tel:${branch.data.phone.replace(/\s/g, '')}`} class="mt-4 inline-block text-sm font-semibold text-ink hover:text-honda-red transition-colors duration-150">
                {branch.data.phone}
              </a>

              <div class="mt-5 flex flex-wrap gap-2">
                <a href={`tel:${branch.data.phone.replace(/\s/g, '')}`} class="hb !px-5 !min-h-[2.75rem]">Call</a>
                <a href={branch.data.map_link} target="_blank" rel="noopener noreferrer" class="hb hb--outline !px-5 !min-h-[2.75rem]">Directions</a>
                <a
                  href={`${WA}?text=${encodeURIComponent(`Hi, I want to visit Prakash Auto Honda ${branch.data.name_en}. [W-BR]`)}`}
                  target="_blank" rel="noopener noreferrer" class="hb hb--wa !px-5 !min-h-[2.75rem]">WhatsApp</a>
              </div>
            </div>
          ))}
        </div>

        <p class="mt-7 flex flex-wrap items-center gap-3 text-sm text-body">
          <span>Nearest showroom:</span>
          <a href="/kamareddy" class="rounded-full border border-ruleSoft px-3 py-1.5 text-xs text-ink2 hover:border-honda-red hover:text-honda-red transition-colors duration-150">Kamareddy</a>
          <a href="/lingampet" class="rounded-full border border-ruleSoft px-3 py-1.5 text-xs text-ink2 hover:border-honda-red hover:text-honda-red transition-colors duration-150">Lingampet</a>
        </p>
      </div>
    </section>

    <!-- ==========================================================
         REVIEWS
         ========================================================== -->
    <section class="border-y border-rule bg-card">
      <div class="max-w-5xl mx-auto px-5 sm:px-8 py-14 lg:py-20">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 class="text-[clamp(1.5rem,3vw,2.25rem)] font-semibold leading-tight text-ink">What customers say</h2>
          <p class="text-sm text-body">4.3 / 5 · 500+ reviews</p>
        </div>
        <p class="mt-1 font-noto text-body">మా కస్టమర్ల అభిప్రాయాలు</p>

        <ul class="mt-9 grid gap-5 sm:grid-cols-2">
          {reviews.map((r) => (
            <li class="rounded-lg border border-ruleSoft bg-paper p-5">
              <p class="flex items-center gap-1" aria-label={`${r.stars} out of 5`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" class={i < r.stars ? 'text-honda-red' : 'text-rule'} fill="currentColor"><path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.2 3.3L7 14.3 2 9.4l7-.9L12 2Z"/></svg>
                ))}
              </p>
              <blockquote class="mt-3 text-sm leading-relaxed text-body">{r.text}</blockquote>
              <p class="mt-4 text-sm font-medium text-ink">{r.name}</p>
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
