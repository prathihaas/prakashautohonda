---
// Ft7 Compact utility — a single hairline-ruled band. Two branches and five
// links do not justify a four-column link farm.
const links = [
  { label: 'All models', href: '/products/' },
  { label: 'Service', href: '/service/' },
  { label: 'Guides', href: '/blog/' },
  { label: 'About', href: '/about/' },
];
const branches = [
  { name: 'Kamareddy', phone: '+91 8886680259', href: '/kamareddy' },
  { name: 'Lingampet', phone: '+91 9985033315', href: '/lingampet' },
];
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-card border-t border-rule">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-12 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <p class="text-lg font-semibold text-ink">Prakash Auto Honda</p>
        <p class="mt-0.5 text-sm text-muted font-noto">ప్రకాష్ ఆటో హోండా</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-body">
          Authorised Honda two-wheeler dealer in Kamareddy, Telangana. Sales, genuine parts
          and service at both branches, Monday to Saturday.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href="tel:+918886604615" class="hb hb--outline">Call 88866 04615</a>
          <a
            href="https://wa.me/918886604615?text=Hi%2C%20I%20want%20to%20enquire%20about%20Honda%202-wheelers%20in%20Kamareddy.%20%5BW-PA%5D"
            target="_blank" rel="noopener noreferrer" class="hb hb--wa">WhatsApp</a>
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Showrooms</p>
        <ul class="mt-4 space-y-4">
          {branches.map((b) => (
            <li>
              <a href={b.href} class="text-sm font-medium text-ink hover:text-honda-red transition-colors duration-150">{b.name}</a>
              <a href={`tel:${b.phone.replace(/\s/g, '')}`} class="block text-sm text-body hover:text-honda-red transition-colors duration-150">{b.phone}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Sections</p>
        <ul class="mt-4 space-y-2.5">
          {links.map((l) => (
            <li><a href={l.href} class="text-sm text-body hover:text-honda-red transition-colors duration-150">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <hr class="h-rule my-10" />

    <div class="flex flex-col gap-3 text-xs text-muted lg:flex-row lg:items-center lg:justify-between">
      <p>© {year} Prakash Auto Honda. Authorised Honda dealer. Honda is a trademark of Honda Motor Co., Ltd.</p>
      <p class="flex flex-wrap gap-x-3 gap-y-1">
        <a href="https://www.prakashhyundai.com" target="_blank" rel="noopener" class="hover:text-honda-red transition-colors duration-150">Prakash Hyundai</a>
        <a href="https://www.prakashmotors.in" target="_blank" rel="noopener" class="hover:text-honda-red transition-colors duration-150">Prakash Motors</a>
        <a href="https://www.sairamhonda.com" target="_blank" rel="noopener" class="hover:text-honda-red transition-colors duration-150">Sairam Honda</a>
      </p>
    </div>
  </div>
</footer>
