---
interface Props {
    title_en: string;
    title_te: string;
    price: string;
    mileage: string;
    image: string;
    slug: string;
    category: string;
}

const { title_en, title_te, price, mileage, image, slug, category } = Astro.props;
---
<a
  href={`/products/${slug}`}
  class="group flex flex-col overflow-hidden rounded-lg bg-card border border-ruleSoft transition-[border-color,box-shadow] duration-200 ease-out hover:border-rule hover:shadow-[0_8px_28px_-14px_rgba(0,0,0,0.28)]"
>
  <div class="relative aspect-[4/3] overflow-hidden bg-paper">
    <span class="absolute top-3 left-3 z-10 rounded-full bg-card/90 px-2.5 py-1 text-[11px] font-medium text-ink2 backdrop-blur">
      {category}
    </span>
    <img
      src={image}
      alt={`Honda ${title_en} at Prakash Auto Honda, Kamareddy`}
      class="h-full w-full object-contain p-4 transition-transform duration-500 ease-out group-hover:scale-[1.04]"
      loading="lazy" decoding="async" />
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold leading-tight text-ink">{title_en}</h3>
    <p class="mt-0.5 font-noto text-sm text-muted">{title_te}</p>

    <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
      <div>
        <dt class="text-[11px] uppercase tracking-[0.12em] text-muted">Price</dt>
        <dd class="mt-0.5 font-semibold text-ink">{price}</dd>
      </div>
      <div>
        <dt class="text-[11px] uppercase tracking-[0.12em] text-muted">Mileage</dt>
        <dd class="mt-0.5 font-semibold text-ink">{mileage}</dd>
      </div>
    </dl>

    <span class="mt-5 inline-flex items-center gap-1.5 pt-4 border-t border-ruleSoft text-sm font-semibold text-honda-red">
      View details
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-150 ease-out group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
